# ============================================================
# RecoverFlow AI — Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# ── MongoDB ──────────────────────────────────────────────────
# Local development:
MONGODB_URI=mongodb://localhost:27017/recoverflow
# Docker (use this when running docker compose):
# MONGODB_URI=mongodb://mongodb:27017/recoverflow

# ── Razorpay Test Mode ───────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI / Gemini ───────────────────────────────────────────────
# Gemini via OpenAI-compatible endpoint (recommended):
#   AI_API_KEY=your-gemini-api-key
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-1.5-flash
#
# Or use OpenAI directly:
#   AI_API_KEY=your-openai-api-key
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#
# If AI_API_KEY is empty, the agent falls back to deterministic rules.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-1.5-flash

# ── Policy Defaults ──────────────────────────────────────────
MAX_RETRIES=2
MAX_RECOVERY_ACTIONS=3
MIN_RECOVERY_SCORE=0.40
MAX_TRANSACTION_AMOUNT=1000000

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
